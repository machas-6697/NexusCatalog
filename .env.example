# ─────────────────────────────────────────────
# NexusCatalog — Environment Variable Template
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── JWT ──────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── PostgreSQL (3 Databases) ─────────────────
POSTGRES_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5400/nexuscatalog
POSTGRES_URL_AUDIT=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5400/nexuscatalog_audit
POSTGRES_URL_INVENTORY=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5400/nexuscatalog_inventory

# ── MongoDB (3 Databases) ────────────────────
MONGO_URL=mongodb://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@localhost:27000/nexuscatalog?authSource=admin
MONGO_DB_NAME=nexuscatalog
MONGO_DB_REVIEWS=nexuscatalog_reviews
MONGO_DB_EVENTS=nexuscatalog_events

# ── App ──────────────────────────────────────
APP_ENV=development
APP_PORT=8000
